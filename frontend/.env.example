 feat_yubran
VITE_FUENTE_DATOS=api
VITE_API_URL=http://localhost:3000/api
# Solo para el modo de demostración opcional:
VITE_DBJSON_URL=http://localhost:3001

# De dónde saca los datos el frontend:
#   dbjson = db.json servido por json-server (Node) en el puerto 3001  ← usar mientras el back end no esté listo
#   api    = back end real (Node + Express + MySQL + Sequelize)
VITE_FUENTE_DATOS=dbjson

# URL de json-server (solo si VITE_FUENTE_DATOS=dbjson)
VITE_DBJSON_URL=http://localhost:3001

# URL base de la API del back end (solo si VITE_FUENTE_DATOS=api)
VITE_API_URL=http://localhost:3000/api
 main
