{
  "name": "ecoobra-inventario-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "server": "json-server --watch db.json --port 3001",
    "db:reset": "node scripts/generar-db.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "demo": "concurrently -n db,web -c green,blue \"npm:server\" \"npm:dev\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.5",
    "json-server": "^0.17.4",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
